# ============================================
# Tetrisnews Emailing - Configuration
# ============================================

# Votre domaine (OBLIGATOIRE)
DOMAIN=mail.votredomaine.com

# Identifiants administrateur
ADMIN_USERNAME=admin
ADMIN_PASSWORD=VotreMotDePasseSecurise123!

# Chemin d'accès sécurisé à l'interface admin
SafePath=tetrisnews

# Hostname du serveur mail (doit correspondre au DNS MX)
BILLIONMAIL_HOSTNAME=mail.votredomaine.com

# ============================================
# Base de données PostgreSQL
# ============================================
DBNAME=tetrisnews
DBUSER=tetrisnews
# Générez un mot de passe sécurisé: openssl rand -base64 32
DBPASS=CHANGEZ_CE_MOT_DE_PASSE_POSTGRESQL

# ============================================
# Redis
# ============================================
# Générez un mot de passe sécurisé: openssl rand -base64 32
REDISPASS=CHANGEZ_CE_MOT_DE_PASSE_REDIS

# ============================================
# Ports Mail (ne pas modifier sauf besoin spécifique)
# ============================================
SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP_PORT=110
POPS_PORT=995

# Ports internes (bind uniquement en local)
REDIS_PORT=127.0.0.1:26379
SQL_PORT=127.0.0.1:25432

# ============================================
# Timezone
# ============================================
TZ=Europe/Paris

# ============================================
# Réseau Docker
# ============================================
IPV4_NETWORK=172.67.1

# ============================================
# Sécurité
# ============================================
FAIL2BAN_INIT=y
IP_WHITELIST_ENABLE=false

# Nombre de jours de rétention des logs
RETENTION_DAYS=7
